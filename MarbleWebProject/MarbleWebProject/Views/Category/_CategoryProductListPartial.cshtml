@using MarbleWebProject.Helper
@model ProductsByCageoryResponse
@{
    int maxPageLinks = 5; // Maximum number of page links to display
    int startPage = Math.Max(1, Model.PageNumber - maxPageLinks / 2);
    int endPage = Math.Min(Model.TotalPages, startPage + maxPageLinks - 1);

    // Adjust the start page if there are not enough pages to display the max count
    if (endPage - startPage < maxPageLinks - 1)
    {
        startPage = Math.Max(1, endPage - maxPageLinks + 1);
    }
}
<div class="row">
