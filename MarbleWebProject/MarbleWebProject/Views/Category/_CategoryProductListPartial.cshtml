</div><!-- End .row -->
@if (Model.TotalPages>1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link page-link-prev" data-page="@(Model.CurrentPage - 1)" aria-label="Prev" @(Model.PageNumber == 1 ? "tabindex='-1' aria-disabled='true'" : "") style="cursor:pointer">
                        <span aria-hidden="true"><i class="icon-long-arrow-left"></i></span>@Html.Translate("#Prev#")
                    </a>
                </li>
            }
        @*     @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" data-page="@i" style="cursor:pointer">@i</a>
                </li>
            } *@
            @for (int i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")" aria-current="@(Model.PageNumber == i ? "page" : "")">
                    <a class="page-link" data-page="@i" style="cursor:pointer">@i</a>
                </li>
            }
            <li class="page-item-total">of @Model.TotalPages</li>
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link page-link-next" data-page="@(Model.CurrentPage + 1)" aria-label="Next" style="cursor:pointer" @(Model.PageNumber == Model.TotalPages ? "tabindex='-1' aria-disabled='true'" : "")>
                        @Html.Translate("#Next#")<span aria-hidden="true"><i class="icon-long-arrow-right"></i></span>
                    </a>
                </li>
            }
        </ul>
    </nav>
}