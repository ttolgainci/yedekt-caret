                @{ ViewData["ProductUrl"] = $"/{Model.Url?.Trim('/')}/{item.Url?.Trim('/')}"; }
                @await Html.PartialAsync("_ProductListTitlePartial", item)
                <div class="product-price">
                    <span class="new-price">@item.Price @item.CurrencyName</span>
                    @*  <span class="old-price">$84.00</span> *@
                </div><!-- End .product-price -->
                @await Html.PartialAsync("_ProductListQuantityPartial", item)
