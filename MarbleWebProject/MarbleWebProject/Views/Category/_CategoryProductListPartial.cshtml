                </a>

                <div class="product-action">
                    @{ ViewData["ProductUrl"] = $"/{Model.Url?.Trim('/')}/{item.Url?.Trim('/')}"; }
                    @await Html.PartialAsync("_ProductListAddToCartPartial", item)
                </div><!-- End .product-action -->
            </figure><!-- End .product-media -->

            <div class="product-body">
                <div class="product-cat">
                    @*  <a href="#">Women</a> *@
