@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model ProductDetailResponse
@if (Model.ProductDetails != null)
{

    @await Component.InvokeAsync("ProductBreadcrumb", new
    {
        name = Model.ProductDetails.ProductName,
        categoryId = Model.ProductDetails.CategoryID
    })
    <!-- End .breadcrumb-nav -->

    <div class="page-content">
        <div class="container">
            <div class="product-details-top mb-2">
                <div class="row">
                    @await Component.InvokeAsync("ProductDetailImage", Model.ProductImages)

                    @await Component.InvokeAsync("ProductInfo", new ProductInfoPageModel
                    {
                        Product = Model.ProductDetails,
                        HasVehicleFitment = Model.VehicleFitments != null && Model.VehicleFitments.Any(x => !string.IsNullOrWhiteSpace(x.Label))
                    })

                </div><!-- End .row -->
            </div><!-- End .product-details-top -->
            @await Component.InvokeAsync("ProductAttributeDetail", new ProductDetailTabsViewModel
            {
                Description = Model.ProductDetails?.Description,
                Product = Model.ProductDetails,
                Attributes = Model.ProductAttributes ?? new List<ProductAttributeList>(),
                VehicleFitments = Model.VehicleFitments ?? new List<ProductVehicleFitmentItem>()
            })


            @await Component.InvokeAsync("ProductDetailSimilar", Model.ProductSimilarData)
        </div><!-- End .container -->
    </div>
}
@section Scripts
{
    <script type="text/javascript">
        $(document).ready(function () {
            $('#fitment-link').on('click', function (e) {
                e.preventDefault();

                var $tabLink = $('#product-fitment-link');
                var $tabPane = $('#product-fitment-tab');
                if (!$tabLink.length || !$tabPane.length) {
                    return;
                }

                var $tabs = $('.product-details-tab');
                if ($tabs.length) {
                    var scrolloffset = ($(window).width() >= 992)
                        ? ($tabs.offset().top - 72)
                        : ($tabs.offset().top - 10);
                    $('html, body').animate({ scrollTop: scrolloffset }, 600);
                }

                $tabs.find('.nav-link').removeClass('active').attr('aria-selected', 'false');
                $tabs.find('.tab-pane').removeClass('show active');
                $tabLink.addClass('active').attr('aria-selected', 'true');
                $tabPane.addClass('show active');
                $tabLink.tab('show');
            });
        });
    </script>
    <script src="~/PageJs/ProductDetail.js" asp-append-version="true"></script>
}
