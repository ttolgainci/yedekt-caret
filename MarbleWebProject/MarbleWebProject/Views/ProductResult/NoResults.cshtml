@model ProductResultSearchViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@await Html.PartialAsync("_PageHeader", Model)

<nav aria-label="breadcrumb" class="breadcrumb-nav mb-2">
    <div class="container">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">@Html.Translate("#Home#")</a></li>
            @if (Model.Mode == ProductSearchMode.Category)
            {
                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
            }
            else if (Model.Mode == ProductSearchMode.Vehicle)
            {
                <li class="breadcrumb-item active" aria-current="page">@Html.Translate("#Search#")</li>
            }
            else
            {
                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
            }
        </ol>
    </div>
</nav>

<div class="page-content">
    <div class="container">
        <div class="product-result-empty text-center">
            <div class="product-result-empty__icon" aria-hidden="true">
                <i class="icon-search"></i>
            </div>
            <h2 class="product-result-empty__title">@Html.Translate("#No products found.#")</h2>
            @if (!string.IsNullOrWhiteSpace(Model.Summary))
            {
                <p class="product-result-empty__lead">@Model.Summary</p>
            }
            <a href="/" class="btn btn-outline-primary-2 btn-minwidth-sm mt-2">
                <span>@Html.Translate("#Home#")</span>
                <i class="icon-long-arrow-right"></i>
            </a>
        </div>
    </div>
</div>
