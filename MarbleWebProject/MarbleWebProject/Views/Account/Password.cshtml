@{
    ViewData["Title"] = "Şifre Değişikliği";
}

<div class="store-account-panel">
    <h2 class="store-account-panel-title">Şifre Değişikliği</h2>

    <form id="password-form" class="store-account-form">
        <label for="password-current">Mevcut Şifre</label>
        <input type="password" class="form-control" id="password-current" autocomplete="current-password" />

        <label for="password-new">Yeni Şifre</label>
        <input type="password" class="form-control" id="password-new" autocomplete="new-password" />

        <label for="password-confirm">Yeni Şifre (Tekrar)</label>
        <input type="password" class="form-control" id="password-confirm" autocomplete="new-password" />

        <div class="store-account-form-footer">
            <button type="submit" class="btn btn-primary store-account-btn-primary" disabled>Şifreyi Güncelle</button>
        </div>
        <p class="store-account-hint text-muted mb-0">Şifre değiştirme özelliği yakında eklenecektir.</p>
    </form>
</div>
