@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Şifremi Unuttum";
    var message = ViewBag.Message as string;
    var error = ViewBag.Error as string;
}

<div class="page-header text-center" style="background-image: url('/assets/images/page-header-bg.jpg')">
    <div class="container">
        <h1 class="page-title">Şifremi Unuttum</h1>
    </div>
</div>

<nav aria-label="breadcrumb" class="breadcrumb-nav mb-2">
    <div class="container">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
            <li class="breadcrumb-item active" aria-current="page">Şifremi Unuttum</li>
        </ol>
    </div>
</nav>

<div class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="alert alert-success">@message</div>
            }
            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="alert alert-danger">@error</div>
            }
            <p class="mb-3">E-posta adresinizi girin. Hesap varsa sıfırlama bağlantısı gönderilir.</p>
            <form method="post" action="/account/forgot-password" class="store-account-form">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label for="email">E-posta</label>
                    <input type="email" class="form-control" id="email" name="email" required autocomplete="email" />
                </div>
                <button type="submit" class="btn btn-outline-primary-2">Bağlantı gönder</button>
            </form>
        </div>
    </div>
</div>
