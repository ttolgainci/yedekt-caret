@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Şifre Sıfırlama";
    var token = ViewBag.Token as string ?? "";
    var error = ViewBag.Error as string;
    var success = ViewBag.Success as string;
}

<div class="page-header text-center" style="background-image: url('/assets/images/page-header-bg.jpg')">
    <div class="container">
        <h1 class="page-title">Şifre Sıfırlama</h1>
    </div>
</div>

<nav aria-label="breadcrumb" class="breadcrumb-nav mb-2">
    <div class="container">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
            <li class="breadcrumb-item active" aria-current="page">Şifre Sıfırlama</li>
        </ol>
    </div>
</nav>

<div class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            @if (!string.IsNullOrWhiteSpace(success))
            {
                <div class="alert alert-success">@success</div>
                <p><a href="/" class="btn btn-outline-primary-2">Ana sayfaya dön</a></p>
            }
            else if (string.IsNullOrWhiteSpace(token))
            {
                <div class="alert alert-warning">Geçersiz veya eksik sıfırlama bağlantısı.</div>
                <p><a href="/account/forgot-password">Yeni bağlantı iste</a></p>
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <div class="alert alert-danger">@error</div>
                }
                <form method="post" action="/account/reset-password" class="store-account-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="token" value="@token" />
                    <div class="form-group">
                        <label for="newPassword">Yeni şifre</label>
                        <input type="password" class="form-control" id="newPassword" name="newPassword" required minlength="6" autocomplete="new-password" />
                    </div>
                    <div class="form-group">
                        <label for="confirmPassword">Yeni şifre (tekrar)</label>
                        <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required minlength="6" autocomplete="new-password" />
                    </div>
                    <button type="submit" class="btn btn-outline-primary-2">Şifreyi kaydet</button>
                </form>
            }
        </div>
    </div>
</div>
