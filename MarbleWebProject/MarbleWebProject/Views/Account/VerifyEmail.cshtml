@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "E-posta Doğrulama";
    var success = ViewBag.Success as string;
    var error = ViewBag.Error as string;
}

<div class="page-header text-center" style="background-image: url('/assets/images/page-header-bg.jpg')">
    <div class="container">
        <h1 class="page-title">E-posta Doğrulama</h1>
    </div>
</div>

<nav aria-label="breadcrumb" class="breadcrumb-nav mb-2">
    <div class="container">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
            <li class="breadcrumb-item active" aria-current="page">E-posta Doğrulama</li>
        </ol>
    </div>
</nav>

<div class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            @if (!string.IsNullOrWhiteSpace(success))
            {
                <div class="alert alert-success">@success</div>
            }
            else
            {
                <div class="alert alert-danger">@(error ?? "Doğrulama başarısız.")</div>
            }
            <p><a href="/" class="btn btn-outline-primary-2">Ana sayfaya dön</a></p>
        </div>
    </div>
</div>
