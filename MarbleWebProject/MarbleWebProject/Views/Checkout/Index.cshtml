@model BasketSetModel
@using MarbleWebProject.Helper
@using MarbleWebProject.Helpers
@using MarbleWebProject.Models
@{
    ViewData["Title"] = "Ödeme";
    var isLoggedIn = ViewBag.IsCustomerLoggedIn as bool? == true;
    var carrierId = ViewBag.CarrierId as int?;
    var carrierName = ViewBag.CarrierName as string;
    var shippingPrice = Model.Info.ShippingPrice;
    var customerEmail = ViewBag.CustomerEmail as string;
    var bankTransferEnabled = ViewBag.BankTransferEnabled as bool? == true;
    var creditCardEnabled = ViewBag.CreditCardEnabled as bool? == true;
    var paymentProviders = ViewBag.PaymentProviders as List<CheckoutPaymentProviderModel> ?? new List<CheckoutPaymentProviderModel>();
    var defaultPaymentProvider = paymentProviders.FirstOrDefault(p => p.IsDefault) ?? paymentProviders.FirstOrDefault();
    var bank = ViewBag.BankInfo as StoreBankTransferInfoModel;
    var bankAccounts = bank?.Accounts?.Where(x => x.IsActive).OrderBy(x => x.SortOrder).ThenBy(x => x.ID).ToList() ?? new List<StoreBankAccountItemModel>();
    var hasBankInfo = bankAccounts.Count > 0;
    var checkoutLegalItems = ViewBag.CheckoutLegalItems as List<StorefrontCheckoutLegalItemModel> ?? new List<StorefrontCheckoutLegalItemModel>();
}

<nav aria-label="breadcrumb" class="breadcrumb-nav">
    <div class="container">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Ana sayfa</a></li>
            <li class="breadcrumb-item"><a href="/cart">Sepet</a></li>
            <li class="breadcrumb-item active" aria-current="page">Ödeme</li>
        </ol>
    </div>
</nav>

<div class="page-content checkout-page">
    <div class="container">
        <form id="checkout-form" action="#" method="post">
            <input type="hidden" id="co-carrier-id" value="@(carrierId.HasValue ? carrierId.Value.ToString() : "")" />
            <input type="hidden" id="co-shipping-address-id" value="" />
            <input type="hidden" id="co-billing-address-id" value="" />
            <input type="hidden" id="co-invoice-type" value="Individual" />
            <input type="hidden" id="co-tax-number" value="" />
            <input type="hidden" id="co-tax-office" value="" />
            <input type="hidden" id="co-company-name" value="" />
            <input type="hidden" id="co-e-invoice" value="false" />
            <input type="hidden" id="co-shipping-city-id" value="" />
            <input type="hidden" id="co-shipping-town-id" value="" />

            <div class="row">
                <div class="col-lg-8">
                    <div class="accordion accordion-rounded checkout-accordion" id="checkout-accordion">

                        @if (!isLoggedIn)
                        {
                            <div class="card card-box card-sm bg-light">
                                <div class="card-header" id="co-heading-guest">
                                    <h2 class="card-title">
                                        <a role="button" data-toggle="collapse" href="#co-collapse-guest" aria-expanded="true" aria-controls="co-collapse-guest">
                                            @Html.Translate("#Guest Information#")
                                        </a>
                                    </h2>
                                </div>
                                <div id="co-collapse-guest" class="collapse show" aria-labelledby="co-heading-guest" data-parent="#checkout-accordion">
                                    <div class="card-body pt-0">
                                        <p class="small text-muted mb-3">
                                            @Html.Translate("#Please enter your details to receive order update emails.#")
                                            @Html.Translate("#To use a saved address, please#") <a href="#" data-toggle="modal" data-target="#signin-modal">@Html.Translate("#Sign in#")</a>.
                                        </p>
                                        <label>@Html.Translate("#Email *#")</label>
                                        <input type="email" class="form-control mb-3" id="co-guest-email" value="@customerEmail" required autocomplete="email" />
                                        <div class="row">
                                            <div class="col-sm-6">
                                                <label>@Html.Translate("#First Name *#")</label>
                                                <input type="text" class="form-control mb-3" id="co-guest-firstname" required autocomplete="given-name" />
                                            </div>
                                            <div class="col-sm-6">
                                                <label>@Html.Translate("#Last Name *#")</label>
                                                <input type="text" class="form-control mb-3" id="co-guest-lastname" required autocomplete="family-name" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="card card-box card-sm bg-light">
                            <div class="card-header" id="co-heading-address">
                                <h2 class="card-title">
                                    <a role="button" data-toggle="collapse" href="#co-collapse-address" aria-expanded="true" aria-controls="co-collapse-address">
                                        @Html.Translate("#Shipping Address#")
                                    </a>
                                </h2>
                            </div>
                            <div id="co-collapse-address" class="collapse show" aria-labelledby="co-heading-address" data-parent="#checkout-accordion">
                                <div class="card-body pt-0">
                                    <div class="checkout-addr-block">
                                        <div class="checkout-addr-section-head">
                                            <span class="checkout-addr-section-title">@Html.Translate("#Shipping Address#")</span>
                                            <button type="button" class="btn btn-link btn-sm p-0 checkout-link-btn" id="co-btn-add-address">@Html.Translate("#Add Address#")</button>
                                        </div>
                                        <div id="co-address-picker" class="checkout-addr-grid"></div>
                                    </div>

                                    <div class="custom-control custom-checkbox checkout-billing-toggle mt-4">
                                        <input type="checkbox" class="custom-control-input" id="co-billing-different" />
                                        <label class="custom-control-label" for="co-billing-different">@Html.Translate("#Use a different billing address#")</label>
                                    </div>

                                    <div id="co-billing-section" class="checkout-addr-block mt-3" style="display:none;">
                                        <div class="checkout-addr-section-head">
                                            <span class="checkout-addr-section-title">@Html.Translate("#Billing Address#")</span>
                                        </div>
                                        <div id="co-billing-address-picker" class="checkout-addr-grid"></div>
                                    </div>

                                    <div class="checkout-order-note mt-4">
                                        <label for="co-order-note" class="checkout-addr-section-title d-block mb-2">@Html.Translate("#Order Note#")</label>
                                        <textarea class="form-control" id="co-order-note" rows="3" placeholder="@Html.Translate("#Enter your note#")"></textarea>
                                    </div>

                                    @if (isLoggedIn)
                                    {
                                        <div class="mt-3">
                                            <label>@Html.Translate("#Email *#")</label>
                                            <input type="email" class="form-control" id="co-email" value="@customerEmail" required />
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="card card-box card-sm bg-light">
                            <div class="card-header" id="co-heading-shipping">
                                <h2 class="card-title">
                                    <a role="button" data-toggle="collapse" href="#co-collapse-shipping" aria-expanded="true" aria-controls="co-collapse-shipping">
                                        Kargo Seçimi
                                    </a>
                                </h2>
                            </div>
                            <div id="co-collapse-shipping" class="collapse show" aria-labelledby="co-heading-shipping" data-parent="#checkout-accordion">
                                <div class="card-body pt-0">
                                    <p class="small text-muted mb-3">Teslimat adresinize göre kargo firması ve ücreti hesaplanır.</p>
                                    <div id="co-carrier-options" class="checkout-carrier-list">
                                        <p class="text-muted small mb-0">Önce teslimat adresi seçin.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card card-box card-sm bg-light">
                            <div class="card-header" id="co-heading-payment">
                                <h2 class="card-title">
                                    <a role="button" data-toggle="collapse" href="#co-collapse-payment" aria-expanded="true" aria-controls="co-collapse-payment">
                                        @Html.Translate("#Payment Options#")
                                    </a>
                                </h2>
                            </div>
                            <div id="co-collapse-payment" class="collapse show" aria-labelledby="co-heading-payment" data-parent="#checkout-accordion">
                                <div class="card-body pt-0">
                                    <div class="checkout-pay-accordion" id="checkout-payment-accordion">

                                        @if (creditCardEnabled && paymentProviders.Count > 0)
                                        {
                                        <div class="checkout-pay-panel" data-payment="CreditCard">
                                            <label class="checkout-pay-header collapsed" aria-expanded="false">
                                                <input type="radio" name="co-payment" value="CreditCard" class="checkout-pay-input" />
                                                <span class="checkout-pay-radio" aria-hidden="true"></span>
                                                <span class="checkout-pay-title">@Html.Translate("#Credit / Debit Card#")</span>
                                                <i class="icon-angle-right checkout-pay-chevron"></i>
                                            </label>
                                            <div id="co-pay-card" class="collapse">
                                                <div class="checkout-pay-body">
                                                    <p class="small text-muted mb-3">Kart bilgilerinizi sitemizde girmiyorsunuz; seçtiğiniz ödeme sağlayıcısının güvenli sayfasında 3D Secure ile ödeme yapılır.</p>
                                                    <div class="checkout-payment-providers" id="co-payment-providers">
                                                        @foreach (var provider in paymentProviders)
                                                        {
                                                            <label class="checkout-provider-card">
                                                                <input type="radio" name="co-payment-provider" value="@provider.Code" @(provider.Code == defaultPaymentProvider?.Code ? "checked" : "") />
                                                                <span class="checkout-provider-card-body">
                                                                    <strong class="d-block">@provider.Name</strong>
                                                                    <span class="d-block small text-muted">Güvenli ödeme sayfasına yönlendirilirsiniz</span>
                                                                </span>
                                                            </label>
                                                        }
                                                    </div>
                                                    <p class="checkout-pay-secure small mb-0 mt-3">
                                                        <strong class="text-success">@Html.Translate("#Secure Shopping:#")</strong>
                                                        @Html.Translate("#Payment will be processed with 3D Secure for your security.#")
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                        }
                                        else
                                        {
                                        <div class="checkout-pay-panel checkout-pay-panel--disabled" data-payment="CreditCard">
                                            <label class="checkout-pay-header collapsed" aria-expanded="false">
                                                <input type="radio" name="co-payment" value="CreditCard" class="checkout-pay-input" disabled />
                                                <span class="checkout-pay-radio" aria-hidden="true"></span>
                                                <span class="checkout-pay-title">@Html.Translate("#Credit / Debit Card#")</span>
                                                <i class="icon-angle-right checkout-pay-chevron"></i>
                                            </label>
                                            <div id="co-pay-card" class="collapse">
                                                <div class="checkout-pay-body">
                                                    <p class="alert alert-light small mb-0">@Html.Translate("#Credit card payment will be available soon.#")</p>
                                                </div>
                                            </div>
                                        </div>
                                        }

                                        @if (bankTransferEnabled)
                                        {
                                        <div class="checkout-pay-panel" data-payment="BankTransfer">
                                            <label class="checkout-pay-header collapsed" aria-expanded="false">
                                                <input type="radio" name="co-payment" value="BankTransfer" class="checkout-pay-input" />
                                                <span class="checkout-pay-radio" aria-hidden="true"></span>
                                                <span class="checkout-pay-title">@Html.Translate("#Bank Transfer / EFT#")</span>
                                                <i class="icon-angle-right checkout-pay-chevron"></i>
                                            </label>
                                            <div id="co-pay-bank" class="collapse">
                                                <div class="checkout-pay-body">
                                                    @if (hasBankInfo)
                                                    {
                                                        var firstBank = true;
                                                        @foreach (var account in bankAccounts)
                                                        {
                                                            <label class="checkout-bank-card">
                                                                <input type="radio" name="co-bank-account" value="@account.ID" @(firstBank ? "checked" : "") />
                                                                <span class="checkout-bank-card-body">
                                                                    <strong class="d-block">@account.BankName</strong>
                                                                    @if (!string.IsNullOrWhiteSpace(account.AccountHolder))
                                                                    {
                                                                        <span class="d-block small text-muted">@account.AccountHolder</span>
                                                                    }
                                                                    <span class="d-block checkout-bank-iban mt-1">@account.Iban</span>
                                                                    <button type="button" class="btn btn-outline-secondary mt-2 js-copy-iban checkout-bank-copy-btn" data-iban="@account.Iban">@Html.Translate("#Copy#")</button>
                                                                </span>
                                                                @if (!string.IsNullOrWhiteSpace(account.Logo))
                                                                {
                                                                    <span class="checkout-bank-card-logo">
                                                                        <img src="@MediaUrlHelper.Build(account.Logo)" alt="@account.BankName" loading="lazy" />
                                                                    </span>
                                                                }
                                                            </label>
                                                            firstBank = false;
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(bank?.Instructions))
                                                        {
                                                            <p class="small text-muted mb-0 mt-2">@bank.Instructions</p>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <p class="text-muted mb-0">@Html.Translate("#Bank account details are not configured yet.#")</p>
                                                    }
                                                    <p class="small text-muted mt-2 mb-0">@Html.Translate("#Please include your order number in the transfer description.#")</p>
                                                </div>
                                            </div>
                                        </div>
                                        }

                                        <div class="checkout-pay-panel is-active" data-payment="CashOnDelivery">
                                            <label class="checkout-pay-header" aria-expanded="true">
                                                <input type="radio" name="co-payment" value="CashOnDelivery" class="checkout-pay-input" checked />
                                                <span class="checkout-pay-radio" aria-hidden="true"></span>
                                                <span class="checkout-pay-title">@Html.Translate("#Cash on delivery#")</span>
                                                <i class="icon-angle-right checkout-pay-chevron"></i>
                                            </label>
                                            <div id="co-pay-cod" class="collapse show">
                                                <div class="checkout-pay-body">
                                                    <p class="mb-0">@Html.Translate("#You can pay with cash or credit card when your order is delivered.#")</p>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <aside class="col-lg-4">
                    <div class="summary checkout-order-summary checkout-summary-sticky">
                        <h3 class="summary-title">@Html.Translate("#Order Summary#")</h3>

                        <ul class="checkout-summary-items">
                            @foreach (var item in Model.CartList)
                            {
                                var qty = item.CartQuantity ?? 1;
                                var lineTotal = (item.Price ?? 0) * qty;
                                var url = item.Url ?? "#";
                                if (!url.StartsWith('/')) { url = "/" + url.TrimStart('/'); }
                                var productName = item.ProductName ?? Html.Translate("#Product#").ToString();
                                <li class="checkout-summary-item">
                                    <a href="@url" class="checkout-summary-item-name" title="@productName">@productName</a>
                                    <span class="checkout-summary-item-qty" title="@($"{Html.Translate("#Qty:#")} {qty}")">@qty</span>
                                    <span class="checkout-summary-item-price" title="@CurrencyDisplayHelper.FormatAmount(lineTotal, item.CurrencyName)">@CurrencyDisplayHelper.FormatAmount(lineTotal, item.CurrencyName)</span>
                                </li>
                            }
                        </ul>

                        <table class="table table-summary checkout-summary-totals">
                            <tbody>
                                <tr class="summary-subtotal">
                                    <td>@Html.Translate("#Subtotal:#")</td>
                                    <td id="co-summary-subtotal">@Html.Raw(Model.Info.Subtotal)</td>
                                </tr>
                                <tr>
                                    <td>@Html.Translate("#Shipping:#")</td>
                                    <td id="co-summary-shipping">
                                        @if (shippingPrice.HasValue)
                                        {
                                            @CurrencyDisplayHelper.FormatAmount(shippingPrice.Value, Model.Info.CurrencyName)
                                        }
                                        else
                                        {
                                            <span class="text-muted">@Html.Translate("#Calculating#")</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(carrierName))
                                        {
                                            <small class="d-block text-muted">@carrierName</small>
                                        }
                                    </td>
                                </tr>
                                <tr class="summary-total">
                                    <td>@Html.Translate("#Total:#")</td>
                                    <td><strong id="co-summary-grand">@Html.Raw(Model.Info.GrandTotal)</strong></td>
                                </tr>
                            </tbody>
                        </table>

                        @if (checkoutLegalItems.Count > 0)
                        {
                            <div class="checkout-legal-consents mb-3" id="co-legal-consents">
                                @foreach (var legal in checkoutLegalItems)
                                {
                                    <div class="custom-control custom-checkbox mb-2">
                                        <input type="checkbox"
                                               class="custom-control-input co-legal-consent"
                                               id="co-legal-@legal.InformationId"
                                               data-information-id="@legal.InformationId"
                                               data-revision-id="@legal.RevisionId"
                                               data-page-code="@legal.PageCode"
                                               data-content-hash="@legal.ContentHash"
                                               required />
                                        <label class="custom-control-label" for="co-legal-@legal.InformationId">
                                            <a href="@legal.Url" target="_blank" rel="noopener">@legal.Title</a> metnini okudum ve kabul ediyorum.
                                        </label>
                                    </div>
                                }
                            </div>
                        }

                        <div class="store-cart-drawer-actions checkout-summary-actions">
                            <button type="submit" class="btn btn-outline-primary-2 btn-block">
                                <span>@Html.Translate("#Place Order#")</span>
                            </button>
                            <a href="/cart" class="btn btn-primary btn-block store-cart-drawer-view-cart">
                                <span>@Html.Translate("#Back to cart#")</span>
                            </a>
                        </div>
                    </div>
                </aside>
            </div>
        </form>
    </div>
</div>

<partial name="_AddressModals" />

@section Styles {
    <link rel="stylesheet" href="~/lib/alertifyjs/css/alertify.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/alertifyjs/css/default.min.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/lib/alertifyjs/js/alertify.min.js" asp-append-version="true"></script>
    <script>
        if (window.alertify) {
            alertify.set('notifier', 'position', 'bottom-right');
            alertify.set('notifier', 'delay', 2.5);
        }
    </script>
    <script src="~/PageJs/checkout.js" asp-append-version="true"></script>
}
