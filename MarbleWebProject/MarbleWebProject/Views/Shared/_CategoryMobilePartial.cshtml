@using MarbleWebProject.Helpers
@model CategoryListModel


<li>

    <a href="@CategoryNavHelper.BuildCategoryUrl(Model)"> @Model.Name</a>
    @if (Model.SubCat.Count > 0)
    {
        <ul>
            @foreach (var subCategory in Model.SubCat)
            {
                @Html.Partial("_CategoryPartial", subCategory)
            }
        </ul>
    }
</li>