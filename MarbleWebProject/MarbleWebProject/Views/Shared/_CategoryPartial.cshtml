@using MarbleWebProject.Helpers
@model CategoryListModel
<li data-nav-id="@CategoryNavHelper.GetCategoryId(Model)">
    <a href="@CategoryNavHelper.BuildCategoryUrl(Model)" class="@((Model.SubCat?.Count ?? 0) > 0 ? "sf-with-ul" : null)">@Model.Name</a>
    @if ((Model.SubCat?.Count ?? 0) > 0)
    {
        <ul>
            @foreach (var subCategory in Model.SubCat!)
            {
                <partial name="_CategoryPartial" model="subCategory" />
            }
        </ul>
    }
</li>
