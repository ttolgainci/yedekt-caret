@model List<HomeBrandModel>
@using MarbleWebProject.Helpers
@{
    var brands = Model?
        .Where(x => !string.IsNullOrWhiteSpace(x.Picture))
        .ToList() ?? new List<HomeBrandModel>();
    if (brands.Count == 0)
    {
        return;
    }

    var enableSliderMotion = brands.Count > 1;
    var owlOptions = new
    {
        nav = false,
        dots = false,
        margin = 0,
        loop = enableSliderMotion,
        autoplay = enableSliderMotion,
        autoplayTimeout = 4000,
        autoplayHoverPause = true,
        smartSpeed = 500,
        slideBy = 1,
        mouseDrag = true,
        touchDrag = true,
        responsive = new Dictionary<string, object>
        {
            ["0"] = new { items = 2 },
            ["420"] = new { items = 3 },
            ["600"] = new { items = 4 },
            ["900"] = new { items = 5 },
            ["1024"] = new { items = 6, nav = enableSliderMotion },
            ["1360"] = new { items = 7, nav = enableSliderMotion }
        }
    };
    var owlOptionsJson = System.Text.Json.JsonSerializer.Serialize(owlOptions);
}
<div class="brands-border owl-carousel owl-simple js-home-brands-carousel" data-toggle="owl"
     data-owl-options="@owlOptionsJson">
    @foreach (var item in brands)
    {
        var slug = !string.IsNullOrWhiteSpace(item.Slug) ? item.Slug : item.Name;
        var href = item.Id > 0 ? UrlSlugHelper.BuildBrandPath(slug, item.Id) : "#";
        <a href="@href" class="brand" title="@item.Name">
            <img src="@MediaUrlHelper.Build(item.Picture)" alt="@item.Name" loading="lazy">
        </a>
    }
</div>
<div class="mb-3 mb-lg-5"></div>
