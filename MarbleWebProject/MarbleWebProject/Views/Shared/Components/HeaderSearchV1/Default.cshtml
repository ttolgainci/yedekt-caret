<div class="header-search header-search-extended header-search-visible header-search-no-radius d-none d-lg-block" data-header-search>
    <a href="#" class="search-toggle" role="button"><i class="icon-search"></i></a>
    <form action="/arama" method="get" class="js-header-search-form" autocomplete="off">
        <div class="header-search-wrapper search-wrapper-wide">
            <label for="header-search-q" class="sr-only">Search</label>
            <input type="search"
                   class="form-control js-header-search-input"
                   name="q"
                   id="header-search-q"
                   placeholder="@Html.Translate("#Search product ...#")"
                   minlength="2"
                   required
                   autocomplete="off"
                   aria-autocomplete="list"
                   aria-controls="header-search-suggest"
                   aria-expanded="false">
            <button class="btn btn-primary" type="submit"><i class="icon-search"></i></button>
            <div class="header-search-suggest" id="header-search-suggest" hidden></div>
        </div>
    </form>
</div>
