@using MarbleWebProject.Helper
@{
    var footer = AppConfig.Storefront.Footer;
}
<footer class="footer footer-2">
    <div class="icon-boxes-container">
        <div class="container">
            <div class="row">
                <div class="col-sm-6 col-lg-3">
                    <div class="icon-box icon-box-side">
                        <span class="icon-box-icon text-dark"><i class="icon-rocket"></i></span>
                        <div class="icon-box-content">
                            <h3 class="icon-box-title">@Html.Translate("#Free Shipping#")</h3>
                            <p>@Html.Translate("#orders $50 or more#")</p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="icon-box icon-box-side">
                        <span class="icon-box-icon text-dark"><i class="icon-rotate-left"></i></span>
                        <div class="icon-box-content">
                            <h3 class="icon-box-title">@Html.Translate("#Free Returns#")</h3>
                            <p>@Html.Translate("#within 30 days#")</p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="icon-box icon-box-side">
                        <span class="icon-box-icon text-dark"><i class="icon-info-circle"></i></span>
                        <div class="icon-box-content">
                            <h3 class="icon-box-title">@Html.Translate("#Get 20% Off 1 Item#")</h3>
                            <p>@Html.Translate("#When you sign up#")</p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="icon-box icon-box-side">
                        <span class="icon-box-icon text-dark"><i class="icon-life-ring"></i></span>
                        <div class="icon-box-content">
                            <h3 class="icon-box-title">@Html.Translate("#We Support#")</h3>
                            <p>@Html.Translate("#24/7 amazing services#")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="footer-newsletter bg-image" style="background-image: url(/assets/images/backgrounds/bg-2.jpg)">
        <div class="container">
            <div class="heading text-center">
                <h3 class="title">@Html.Translate("#Get The Latest Deals#")</h3>
                <p class="title-desc">@Html.Translate("#and receive#") <span>$20 @Html.Translate("#coupon#")</span></p>
            </div>
            <div class="row">
                <div class="col-sm-10 offset-sm-1 col-md-8 offset-md-2 col-lg-6 offset-lg-3">
                    @if (StorefrontFlagHelper.IsActive(footer, "FooterSendMailV1"))
                    {
                        @await Component.InvokeAsync("FooterSendMailV1")
                    }
                    else @if (StorefrontFlagHelper.IsActive(footer, "FooterSendMailV2"))
                    {
                        @await Component.InvokeAsync("FooterSendMailV2")
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="footer-middle">
        <div class="container">
            <div class="row">
                <div class="col-sm-12 col-lg-6">
                    <div class="widget widget-about">
                        <img src="@StoreBrandingHelper.GetLogoUrl()" class="footer-logo" alt="@StoreBrandingHelper.GetStoreName()" width="105" height="25">
                        @if (StorefrontFlagHelper.IsActive(footer, "FooterInfoTopV1"))
                        {
                            @await Component.InvokeAsync("FooterInfoTopV1")
                        }
                        else @if (StorefrontFlagHelper.IsActive(footer, "FooterInfoTopV2"))
                        {
                            @await Component.InvokeAsync("FooterInfoTopV2")
                        }
                    </div>
                </div>
                @if (StorefrontFlagHelper.IsActive(footer, "FooterLinkV1"))
                {
                    @await Component.InvokeAsync("FooterLinkV1")
                }
                else @if (StorefrontFlagHelper.IsActive(footer, "FooterLinkV2"))
                {
                    @await Component.InvokeAsync("FooterLinkV2")
                }
            </div>
        </div>
    </div>

    <div class="footer-bottom">
        <div class="container">
            <p class="footer-copyright">Copyright © @DateTime.Now.Year @AppConfig.ProjectName. @Html.Translate("#All Rights Reserved.#")</p>
            @if (StorefrontFlagHelper.IsActive(footer, "FooterSocialMediaV1"))
            {
                @await Component.InvokeAsync("FooterSocialMediaV1")
            }
            else @if (StorefrontFlagHelper.IsActive(footer, "FooterSocialMediaV2"))
            {
                @await Component.InvokeAsync("FooterSocialMediaV2")
            }
        </div>
    </div>
</footer>
