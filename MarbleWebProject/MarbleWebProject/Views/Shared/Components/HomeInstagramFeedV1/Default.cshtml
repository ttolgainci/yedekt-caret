@model MarbleWebProject.Models.StorefrontInstagramFeedModel
@{
    var posts = Model.Accounts.SelectMany(a => a.Posts.Select(p => new { Account = a, Post = p }))
        .OrderByDescending(x => x.Post.PostedAtUtc)
        .Take(12)
        .ToList();
}
@if (posts.Count > 0)
{
    var headlineAccount = Model.Accounts.FirstOrDefault();
    <div class="container instagram-feed-section pt-5 pb-5 mb-2">
        <div class="heading text-center mb-4">
            <h2 class="title">Instagram</h2>
            @if (headlineAccount != null && !string.IsNullOrWhiteSpace(headlineAccount.Username))
            {
                <p class="title-desc">
                    <a href="https://www.instagram.com/@headlineAccount.Username/" target="_blank" rel="noopener noreferrer">
                        @@@headlineAccount.Username
                    </a>
                </p>
            }
        </div>
        <div class="row instagram-feed-grid">
            @foreach (var item in posts)
            {
                <div class="col-6 col-md-4 col-lg-3 mb-4">
                    <a href="@item.Post.Permalink" class="instagram-feed-item d-block" target="_blank" rel="noopener noreferrer" title="@item.Post.Caption">
                        <img src="@item.Post.ImageUrl" alt="@item.Post.Caption" class="img-fluid w-100" loading="lazy" style="aspect-ratio:1/1;object-fit:cover;" />
                    </a>
                </div>
            }
        </div>
    </div>
}
