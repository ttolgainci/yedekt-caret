@model MarbleWebProject.Models.StorefrontFooterLinksModel
@using MarbleWebProject.Helper
@{
    var groups = Model?.Groups ?? new List<MarbleWebProject.Models.StorefrontFooterLinkGroupModel>();
}

@foreach (var group in groups)
{
    if (group.Links == null || group.Links.Count == 0)
    {
        continue;
    }

    <div class="col-sm-4 col-lg-2">
        <div class="widget">
            <h4 class="widget-title">@group.Title</h4>
            <ul class="widget-list">
                @foreach (var link in group.Links)
                {
                    <li><a href="@link.Url">@link.Title</a></li>
                }
            </ul>
        </div>
    </div>
}

<div class="col-sm-4 col-lg-2">
    <div class="widget">
        <h4 class="widget-title">@Html.Translate("#My Account#")</h4>
        <ul class="widget-list">
            <li><a href="/account/profile">@Html.Translate("#My Account#")</a></li>
            <li><a href="/cart">@Html.Translate("#View Cart#")</a></li>
            <li><a href="/account/orders">@Html.Translate("#Track My Order#")</a></li>
        </ul>
    </div>
</div>
