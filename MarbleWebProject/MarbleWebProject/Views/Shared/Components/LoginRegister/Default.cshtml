@using MarbleWebProject.Helper
<div class="modal fade" id="signin-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true"><i class="icon-close"></i></span>
                </button>

                <div class="form-box">
                    <div class="form-tab">
                        <ul class="nav nav-pills nav-fill" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" id="signin-tab" data-toggle="tab" href="#signin" role="tab" aria-controls="signin" aria-selected="true">@Html.Translate("#Sign In#")</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="register-tab" data-toggle="tab" href="#register" role="tab" aria-controls="register" aria-selected="false">@Html.Translate("#Register#")</a>
                            </li>
                        </ul>
                        <div id="customer-auth-alert" class="alert alert-danger d-none mt-2" role="alert"></div>
                        <div class="tab-content" id="tab-content-5">
                            <div class="tab-pane fade show active" id="signin" role="tabpanel" aria-labelledby="signin-tab">
                                <form id="customer-login-form" class="js-customer-login-form" action="#" method="post">
                                    <div class="form-group">
                                        <label for="singin-email">@Html.Translate("#Email Address#") *</label>
                                        <input type="email" class="form-control" id="singin-email" name="email" required autocomplete="username">
                                    </div>

                                    <div class="form-group">
                                        <label for="singin-password">@Html.Translate("#Password#") *</label>
                                        <input type="password" class="form-control" id="singin-password" name="password" required autocomplete="current-password">
                                    </div>

                                    <div class="form-footer">
                                        <button type="submit" class="btn btn-outline-primary-2">
                                            <span>@Html.Translate("#Login#")</span>
                                            <i class="icon-long-arrow-right"></i>
                                        </button>

                                        <div class="custom-control custom-checkbox">
                                            <input type="checkbox" class="custom-control-input" id="signin-remember">
                                            <label class="custom-control-label" for="signin-remember">@Html.Translate("#Remember Me#")</label>
                                        </div>
                                    </div>
                                </form>
                            </div>
                            <div class="tab-pane fade" id="register" role="tabpanel" aria-labelledby="register-tab">
                                <form id="customer-register-form" class="js-customer-register-form" action="#" method="post">
                                    <div class="form-group">
                                        <label for="register-firstname">@Html.Translate("#Name#") *</label>
                                        <input type="text" class="form-control" id="register-firstname" name="firstName" required autocomplete="given-name">
                                    </div>
                                    <div class="form-group">
                                        <label for="register-lastname">@Html.Translate("#Surname#") *</label>
                                        <input type="text" class="form-control" id="register-lastname" name="lastName" required autocomplete="family-name">
                                    </div>
                                    <div class="form-group">
                                        <label for="register-email">@Html.Translate("#Email Address#") *</label>
                                        <input type="email" class="form-control" id="register-email" name="email" required autocomplete="email">
                                    </div>
                                    <div class="form-group">
                                        <label for="register-phone">@Html.Translate("#Phone#")</label>
                                        <input type="text" class="form-control" id="register-phone" name="phone" autocomplete="tel">
                                    </div>
                                    <div class="form-group">
                                        <label for="register-password">@Html.Translate("#Password#") *</label>
                                        <input type="password" class="form-control" id="register-password" name="password" required autocomplete="new-password">
                                    </div>
                                    <div class="form-group">
                                        <label for="register-password-confirm">@Html.Translate("#Again Password#") *</label>
                                        <input type="password" class="form-control" id="register-password-confirm" name="passwordConfirm" required autocomplete="new-password">
                                    </div>
                                    <div class="form-footer">
                                        <button type="submit" class="btn btn-outline-primary-2">
                                            <span>@Html.Translate("#Register#")</span>
                                            <i class="icon-long-arrow-right"></i>
                                        </button>
                                        <br />
                                        <a href="#signin" class="forgot-link" data-toggle="tab">@Html.Translate("#I already have an account#")</a>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
