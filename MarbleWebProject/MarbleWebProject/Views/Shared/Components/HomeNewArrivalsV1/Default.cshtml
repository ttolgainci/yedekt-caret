@using MarbleWebProject.Helper
@model List<MarbleWebProject.Models.ProductList>
@if (Model.Count > 0)
{
    <div class="bg-lighter pt-5 pb-5 mb-5">
        <div class="container">
            <div class="heading text-center mb-4">
                <h2 class="title">@Html.Translate("#New Arrivals#")</h2>
                <p class="title-desc">@Html.Translate("#New arrivals subtitle#")</p>
            </div>

            <div class="owl-carousel owl-simple carousel-equal-height carousel-with-shadow" data-toggle="owl"
                 data-owl-options='{
                    "nav": false,
                    "dots": true,
                    "margin": 20,
                    "loop": false,
                    "responsive": {
                        "0": { "items": 2 },
                        "480": { "items": 2 },
                        "768": { "items": 3 },
                        "992": { "items": 4 },
                        "1200": { "items": 5, "nav": true }
                    }
                }'>
                @foreach (var item in Model)
                {
                    ViewData["ProductLabel"] = Html.Translate("#New#").ToString();
                    ViewData["ProductLabelClass"] = "product-label label-circle label-new";
                    @await Html.PartialAsync("_ProductListCardPartial", item)
                    ViewData.Remove("ProductLabel");
                    ViewData.Remove("ProductLabelClass");
                }
            </div>
        </div>
    </div>
}
