@model List<ProductAttributeList>

<div class="product-details-tab">
    <ul class="nav nav-pills justify-content-center" role="tablist">
        @{
            int liIndex = 0;
        }
        @foreach (var item in Model)
        {
            string setclass = liIndex == 0 ? "active" : "";
            <li class="nav-item">
                <a class="nav-link @liIndex @setclass" id="product-desc-li-@liIndex" data-toggle="tab" href="#product-desc-@liIndex" role="tab" aria-controls="product-desc-tab" aria-selected="true">@item.AttributeName</a>
            </li>
            liIndex++;
        }

    </ul>
    <div class="tab-content">
        @{
            int tabIndex = 0;
        }
        @foreach (var item in Model)
        {
            string setclass = tabIndex == 0 ? "show active" : "";
            <div class="tab-pane fade @setclass" id="product-desc-@tabIndex" role="tabpanel" aria-labelledby="product-desc-@tabIndex">
                <div class="product-desc-content">
                    @Html.Raw(item.AttributeDescription)
                </div>
            </div>
            tabIndex++;
        }


    </div><!-- End .tab-content -->
</div><!-- End .product-details-tab -->