<div class="blog-posts">
    <div class="container">
        <h2 class="title text-center">@Html.Translate("#From Our Blog#")</h2>
        <div class="owl-carousel owl-simple carousel-with-shadow" data-toggle="owl"
             data-owl-options='{"nav": false, "dots": true, "items": 3, "margin": 20, "loop": false, "responsive": {"0":{"items":1},"600":{"items":2},"992":{"items":3}}}'>
            @for (var i = 1; i <= 3; i++)
            {
                <article class="entry entry-display">
                    <figure class="entry-media">
                        <a href="#"><img src="~/assets/images/demos/demo-2/blog/post-@(i).jpg" alt="blog"></a>
                    </figure>
                    <div class="entry-body text-center">
                        <h3 class="entry-title"><a href="#">@Html.Translate("#Blog post#") @i</a></h3>
                        <div class="entry-content">
                            <a href="#" class="read-more">@Html.Translate("#Continue Reading#")</a>
                        </div>
                    </div>
                </article>
            }
        </div>
    </div>
</div>
