@using MarbleWebProject.Helper
@model List<MarbleWebProject.Models.ProductList>
@if (Model.Count > 0)
{
<div class="bg-lighter pt-5 pb-5 mb-5">
    <div class="container">
        <div class="heading text-center mb-4">
            <h2 class="title">@Html.Translate("#Featured Products#")</h2>
            <p class="title-desc">@Html.Translate("#Featured products subtitle#")</p>
        </div>

        <div class="owl-carousel owl-simple" data-toggle="owl"
             data-owl-options='{
                "nav": false,
                "dots": true,
                "margin": 20,
                "loop": false,
                "responsive": {
                    "0": { "items": 1 },
                    "480": { "items": 1 },
                    "768": { "items": 3 },
                    "992": { "items": 4 },
                    "1200": { "items": 4, "nav": true }
                }
            }'>
            @foreach (var item in Model)
            {
                var img = MediaUrlHelper.BuildProductImage(item.MainImage);
                var hoverImg = item.Images != null && item.Images.Count > 1
                    ? MediaUrlHelper.Build(item.Images[1].Image)
                    : img;
                var productUrl = (item.Url ?? "#").Trim();
                if (!productUrl.StartsWith('/'))
                    productUrl = "/" + productUrl.TrimStart('/');
                <div class="product product-4">
                    <figure class="product-media">
                        <a href="@productUrl">
                            <img src="@img" alt="@item.ProductName" class="product-image">
                            @if (!string.Equals(img, hoverImg, StringComparison.OrdinalIgnoreCase))
                            {
                                <img src="@hoverImg" alt="@item.ProductName" class="product-image-hover">
                            }
                        </a>
                        <div class="product-action-vertical">
                            @{ ViewData["ProductUrl"] = productUrl; }
                            @await Html.PartialAsync("_ProductListWishlistPartial", item)
                        </div>
                        <div class="product-action">
                            @await Html.PartialAsync("_ProductListAddToCartPartial", item)
                        </div>
                    </figure>
                    <div class="product-body">
                        @if (!string.IsNullOrWhiteSpace(item.CategoryName))
                        {
                            <div class="product-cat">
                                <span>@item.CategoryName</span>
                            </div>
                        }
                        @{ ViewData["ProductUrl"] = productUrl; }
                        @await Html.PartialAsync("_ProductListTitlePartial", item)
                        @if (item.Price.HasValue)
                        {
                            <div class="product-price">@item.Price @item.CurrencyName</div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
}
