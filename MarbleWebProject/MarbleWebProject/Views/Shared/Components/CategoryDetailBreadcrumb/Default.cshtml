@using MarbleWebProject.Helper
@model List<CategoryBreadcrumbModel>
<nav aria-label="breadcrumb" class="breadcrumb-nav breadcrumb-with-filter">
    <div class="container">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">@Html.Translate("#Home#")</a></li>
            @if (Model.Count>0)
            {
               foreach (var item in Model)
                {
                     <li class="breadcrumb-item"><a href="@item.Url">@item.Name</a></li>
                }

            }
        </ol>
    </div><!-- End .container -->
</nav>