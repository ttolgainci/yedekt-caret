@using MarbleWebProject.Helper
@using MarbleWebProject.Helpers
@model List<CategoryBreadcrumbModel>
<nav aria-label="breadcrumb" class="breadcrumb-nav breadcrumb-with-filter">
    <div class="container">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">@Html.Translate("#Home#")</a></li>
            @if (Model != null && Model.Count > 0)
            {
                foreach (var item in Model)
                {
                    var slugSource = (item.Url ?? "").Trim().Trim('/');
                    if (slugSource.StartsWith("category/", StringComparison.OrdinalIgnoreCase))
                        slugSource = slugSource["category/".Length..];
                    slugSource = slugSource.Split('/').LastOrDefault() ?? "";
                    if (UrlSlugHelper.TryParseCategoryPath(slugSource, out _, out var slugPart) && !string.IsNullOrWhiteSpace(slugPart))
                        slugSource = slugPart;

                    var categoryHref = UrlSlugHelper.BuildCategoryPath(slugSource, item.ID);
                    <li class="breadcrumb-item"><a href="@categoryHref">@item.Name</a></li>
                }
            }
        </ol>
    </div><!-- End .container -->
</nav>
