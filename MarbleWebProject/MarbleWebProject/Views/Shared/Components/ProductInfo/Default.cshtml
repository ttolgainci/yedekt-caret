@using System.Linq
@using MarbleWebProject.Helper
@using MarbleWebProject.Helpers
@model ProductInfoPageModel
@{
    var p = Model.Product;
    var addToCartLabel = Html.Translate("#Add to cart#");
    var inBasketLabel = Html.Translate("#in the basket#");
    var btnText = addToCartLabel;
    int? basketQuantity = 0;

    if (p.HasBasket)
    {
        basketQuantity = p.BasketQuantity;
        btnText = inBasketLabel;
    }

    var qty = p.Quantity ?? 0;
    string stockIcon;
    string stockText;
    if (qty <= 0)
    {
        stockIcon = "✖";
        stockText = Html.Translate("#Out of stock#");
    }
    else if (qty <= 3)
    {
        stockIcon = "⚠";
        var lastLabel = Html.Translate("#Only {0} left#");
        stockText = lastLabel.Contains("{0}", StringComparison.Ordinal)
            ? string.Format(lastLabel, qty)
            : $"{lastLabel} {qty}";
    }
    else
    {
        stockIcon = "✓";
        stockText = Html.Translate("#In stock#");
    }

    var stockCode = !string.IsNullOrWhiteSpace(p.Sku) ? p.Sku : p.ProductCode;
    var oemText = p.OemCodes != null && p.OemCodes.Count > 0
        ? string.Join(", ", p.OemCodes.Where(x => !string.IsNullOrWhiteSpace(x)))
        : (p.ProductModel ?? "");

    string? brandUrl = null;
    if (p.BrandID is > 0)
    {
        brandUrl = !string.IsNullOrWhiteSpace(p.BrandSlug)
            ? "/" + p.BrandSlug.Trim().TrimStart('/')
            : "/arama?brandId=" + p.BrandID.Value;
    }

    var brandPictureUrl = !string.IsNullOrWhiteSpace(p.BrandPicture)
        ? MediaUrlHelper.Build(p.BrandPicture)
        : "";

    var auth = AppConfig.Storefront?.StoreAuth;
    var showShipEstimate = auth?.ShowSameDayShippingEstimate != false && (auth?.SameDayShippingCutoffHour ?? 16) >= 0;
    string? shipEstimateText = null;
    if (showShipEstimate && qty > 0)
    {
        var cutoffHour = auth?.SameDayShippingCutoffHour ?? 16;
        var cutoffMinute = Math.Clamp(auth?.SameDayShippingCutoffMinute ?? 0, 0, 59);
        var now = DateTime.Now;
        var cutoff = new DateTime(now.Year, now.Month, now.Day, cutoffHour, cutoffMinute, 0);
        var cutoffLabel = cutoff.ToString("HH:mm");
        if (now <= cutoff)
        {
            var tpl = Html.Translate("#Order by {0} today → Ships today#");
            shipEstimateText = tpl.Contains("{0}", StringComparison.Ordinal)
                ? string.Format(tpl, cutoffLabel)
                : tpl;
        }
        else
        {
            shipEstimateText = Html.Translate("#Order now → Ships tomorrow#");
        }
    }

    var tags = (p.Tags ?? "")
        .Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
        .Select(t => t.Trim())
        .Where(t => t.Length > 0)
        .ToList();
}

<div class="col-md-6">
    <div class="product-details product-detail-code_@p.ProductID">
        <h1 class="product-title">@p.ProductName</h1><!-- End .product-title -->

        <div class="product-price">
            @CurrencyDisplayHelper.FormatAmount(p.Price, p.CurrencyName)
        </div><!-- End .product-price -->

        @if (!string.IsNullOrEmpty(p.ShortDescription))
        {
            <div class="product-content">
                @Html.Raw(p.ShortDescription)
            </div><!-- End .product-content -->
        }

        @if (!string.IsNullOrWhiteSpace(p.BrandName))
        {
            <div class="details-filter-row details-row-size">
                <label>@Html.Translate("#Brand#"):</label>
                @if (!string.IsNullOrWhiteSpace(brandPictureUrl))
                {
                    <span class="product-brand-thumb">
                        <img src="@brandPictureUrl" alt="@p.BrandName" width="120" height="45">
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(brandUrl))
                {
                    <a href="@brandUrl" class="product-brand-name-link">@Html.Translate("#View all brands from#") @p.BrandName</a>
                }
                else
                {
                    <span>@p.BrandName</span>
                }
            </div><!-- End .details-filter-row -->
        }

        @if (!string.IsNullOrWhiteSpace(stockCode))
        {
            <div class="details-filter-row details-row-size">
                <label>@Html.Translate("#Stock Code#"):</label>
                @stockCode
            </div><!-- End .details-filter-row -->
        }

        @if (!string.IsNullOrWhiteSpace(oemText))
        {
            <div class="details-filter-row details-row-size">
                <label>@Html.Translate("#OEM#"):</label>
                @oemText
            </div><!-- End .details-filter-row -->
        }

        <div class="details-filter-row details-row-size">
            <label>@Html.Translate("#Stock Status#"):</label>
            <span class="product-stock-inline-icon" aria-hidden="true">@stockIcon</span>
            <span>@stockText</span>
        </div><!-- End .details-filter-row -->

        @if (!string.IsNullOrWhiteSpace(shipEstimateText))
        {
            <div class="details-filter-row details-row-size">
                <label>@Html.Translate("#Estimated shipping#"):</label>
                <div class="product-detail-value">
                    <i class="icon-truck"></i> @shipEstimateText
                </div>
            </div><!-- End .details-filter-row -->
        }

        <div class="product-details-action">
            <div class="details-action-col">
                <div class="product-details-quantity">
                    <input type="number" class="form-control product-detail-Quantity" value="@basketQuantity" min="@p.MinimumQuantity" max="@p.Quantity" step="1" data-decimals="0" required>
                </div><!-- End .product-details-quantity -->
                <a href="#" onclick="setProductToBasket(this); return false;" data-pid="@p.ProductID" data-purl="@p.Url" data-add-label="@addToCartLabel" data-inbasket-label="@inBasketLabel" class="btn-product btn-cart"><span>@btnText</span></a>
                <div class="details-action-wrapper"><a href="#" data-pid="@p.ProductID" onclick="setProductToSepete(this)" class="btn-product btn-wishlist" title="Wishlist"><span>@Html.Translate("#Add to Wishlist#")</span></a></div>
            </div><!-- End .details-action-col -->
        </div><!-- End .product-details-action -->
        @if (Model.HasVehicleFitment)
        {
            <div class="product-details-footer">
                <div class="product-cat">
                    <a href="#product-fitment-link" id="fitment-link" class="btn-product product-fitment-link"><span>@Html.Translate("#Which vehicles is this part compatible with?#")</span></a>
                </div><!-- End .product-cat -->
            </div>

            <!-- End .product-details-footer -->
        }
        @if (tags.Count > 0)
        {
            <div class="product-details-footer">
                <div class="product-cat">
                    <span>@Html.Translate("#Tags#"):</span>
                    @for (var i = 0; i < tags.Count; i++)
                    {
                        <span>@tags[i]</span>@(i < tags.Count - 1 ? ", " : "")
                    }
                </div><!-- End .product-cat -->
            </div><!-- End .product-details-footer -->
        }
    </div><!-- End .product-details -->
</div>
