@using MarbleWebProject.Helper
@model List<MarbleWebProject.Models.ProductList>
@if (Model.Count > 0)
{
<div class="container top-selling-container mb-5">
    <h2 class="title text-center mb-3">@Html.Translate("#Top Selling Products#")</h2>
    <div class="owl-carousel owl-simple carousel-equal-height carousel-with-shadow" data-toggle="owl"
         data-owl-options='{"nav": false, "dots": true, "margin": 20, "loop": false, "responsive": {"0":{"items":2},"480":{"items":2},"768":{"items":3},"992":{"items":4},"1200":{"items":5,"nav":true}}}'>
        @foreach (var item in Model)
        {
            @await Html.PartialAsync("_ProductListCardPartial", item)
        }
    </div>
</div>
}
