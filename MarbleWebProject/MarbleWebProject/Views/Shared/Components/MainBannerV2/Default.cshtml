@model MainBannerV2ViewModel
@{
    var slides = Model?.Slides ?? new List<AllBannerResponse>();
    if (slides.Count == 0)
    {
        return;
    }

    string Href(AllBannerResponse item) =>
        string.IsNullOrWhiteSpace(item.Url) ? "#" : "/" + item.Url.TrimStart('/');

    const string owlOptions = """{"loop": true, "nav": false, "responsive": {"768": {"nav": true}}}""";
}
<div class="intro-section bg-lighter pt-5 pb-6">
    <div class="container">
        <div class="row align-items-stretch">
            <div class="col-lg-8">
                <div class="intro-slider-container slider-container-ratio slider-container-1 mb-2 mb-lg-0">
                    <div class="intro-slider intro-slider-1 owl-carousel owl-simple owl-light owl-nav-inside" data-toggle="owl"
                         data-owl-options='@owlOptions'>
                        @foreach (var item in slides)
                        {
                            var img = MediaUrlHelper.Build(item.Image);
                            if (string.IsNullOrWhiteSpace(img) && !string.IsNullOrWhiteSpace(item.Image))
                            {
                                var rel = item.Image.Trim().Replace('\\', '/').TrimStart('/');
                                img = AppConfig.CDNServices.ContentUploads.TrimEnd('/') + "/" + rel;
                            }
                            var href = Href(item);
                            var slideTitle = !string.IsNullOrWhiteSpace(item.Title) ? item.Title : item.Name;
                            var slideSubtitle = item.Subtitle ?? "";
                            var alt = string.IsNullOrWhiteSpace(slideTitle) ? "Slide" : slideTitle;
                            <div class="intro-slide">
                                <figure class="slide-image">
                                    <picture>
                                        <source media="(max-width: 480px)" srcset="@img">
                                        <img src="@img" alt="@alt" width="1920" height="1080" decoding="async">
                                    </picture>
                                </figure>
                                <div class="intro-content">
                                    @if (!string.IsNullOrWhiteSpace(slideSubtitle))
                                    {
                                        <h3 class="intro-subtitle">@slideSubtitle</h3>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(slideTitle))
                                    {
                                        <h1 class="intro-title">@Html.Raw(slideTitle.Replace("\n", "<br />"))</h1>
                                    }
                                    <a href="@href" class="btn btn-outline-white">
                                        <span>@Html.Translate("#View#")</span>
                                        <i class="icon-long-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                    <span class="slider-loader"></span>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="home-vehicle-search-wrap mb-2 mb-lg-0">
                    @await Html.PartialAsync("_HomeVehicleSearchPanel", Model?.VehicleMakes ?? new List<VehicleMakeListItem>())
                </div>
            </div>
        </div>
        <div class="mb-6"></div>
    </div>
</div>
