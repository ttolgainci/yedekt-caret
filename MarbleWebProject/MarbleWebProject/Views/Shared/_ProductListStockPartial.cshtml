@model ProductList
@if (!string.IsNullOrWhiteSpace(Model.StockStatus))
{
    <span class="product-label product-label-stock@(string.IsNullOrWhiteSpace(Model.StockStatusColor) ? " product-label-stock--brand" : null)"@(string.IsNullOrWhiteSpace(Model.StockStatusColor) ? null : Html.Raw($" style=\"background-color:{Model.StockStatusColor}\""))>@Model.StockStatus</span>
}
