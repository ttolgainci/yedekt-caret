@using MarbleWebProject.Helper
@model ProductList
@{
    var productUrl = (ViewData["ProductUrl"] as string ?? Model.Url ?? "#").Trim();
    if (!productUrl.StartsWith('/'))
    {
        productUrl = "/" + productUrl.TrimStart('/');
    }
    var addLabel = Html.Translate("#Add to Wishlist#");
    var removeLabel = Html.Translate("#Remove from Wishlist#");
    var wishlistStyle = (ViewData["WishlistButtonStyle"] as string ?? "icon").Trim().ToLowerInvariant();
    var isList = wishlistStyle is "list" or "list-icon";
    var isListIconOnly = wishlistStyle == "list-icon";
    var btnClass = isList
        ? "btn-product btn-wishlist js-toggle-wishlist"
        : "btn-product-icon btn-wishlist js-toggle-wishlist";
}
<a href="#"
   class="@btnClass"
   data-pid="@Model.ProductID"
   data-purl="@productUrl"
   data-add-label="@addLabel"
   data-remove-label="@removeLabel"
   aria-label="@addLabel"
   onclick="toggleWishlist(this); return false;">
    @if (isList)
    {
        <span class="@(isListIconOnly ? "sr-only" : null)">@addLabel</span>
    }
    else
    {
        <span class="sr-only">@addLabel</span>
    }
</a>
