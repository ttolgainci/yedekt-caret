<div id="store-page-loading"
     class="store-page-loading"
     aria-hidden="true"
     aria-live="polite"
     data-logo-src="@StoreBrandingHelper.GetLogoUrl()">
    <div class="store-page-loading-inner">
        <img src="@StoreBrandingHelper.GetLogoUrl()"
             alt=""
             class="store-page-loading-logo"
             width="105"
             height="25" />
        <div class="store-page-loading-spinner" aria-hidden="true"></div>
    </div>
</div>
