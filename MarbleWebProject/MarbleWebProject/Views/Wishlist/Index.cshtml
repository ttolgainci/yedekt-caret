@using MarbleWebProject.Helper
@model WishlistSetModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Html.Translate("#Wishlist#").ToString();
    var requiresLogin = ViewBag.WishlistRequiresLogin == true;
    var hasItems = !requiresLogin && Model.Items.Count > 0;
}

<nav aria-label="breadcrumb" class="breadcrumb-nav">
    <div class="container">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">@Html.Translate("#Home#")</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Html.Translate("#Wishlist#")</li>
        </ol>
    </div>
</nav>

<div class="page-content pb-5">
    <div class="container">
        <h2 class="title text-center mb-4">@Html.Translate("#Wishlist#")</h2>

        @if (requiresLogin)
        {
            <div class="product-result-empty text-center">
                <div class="product-result-empty__icon" aria-hidden="true">
                    <i class="icon-heart-o"></i>
                </div>
                <h3 class="product-result-empty__title">@Html.Translate("#Please sign in to view your wishlist.#")</h3>
                <a href="#signin-modal" data-toggle="modal" class="btn btn-primary btn-minwidth-sm mt-2">
                    <span>@Html.Translate("#Sign in / Sign up#")</span>
                </a>
            </div>
        }
        else if (!hasItems)
        {
            <div id="wishlist-empty-state" class="product-result-empty text-center">
                <div class="product-result-empty__icon" aria-hidden="true">
                    <i class="icon-heart-o"></i>
                </div>
                <h3 class="product-result-empty__title">@Html.Translate("#Your wishlist is empty.#")</h3>
                <a href="/" class="btn btn-outline-primary-2 btn-minwidth-sm mt-2">
                    <span>@Html.Translate("#Home#")</span>
                    <i class="icon-long-arrow-right"></i>
                </a>
            </div>
        }
        else
        {
            <div id="wishlist-products" class="row wishlist-page-grid">
                @foreach (var item in Model.Items)
                {
                    var img = MediaUrlHelper.BuildProductImage(item.MainImage);
                    var productUrl = "/" + (item.Url ?? "").TrimStart('/');
                    <div class="col-6 col-md-4 col-lg-3 wishlist-product-item" data-pid="@item.ProductID">
                        <div class="product product-7 text-center">
                            <figure class="product-media">
                                <a href="@productUrl">
                                    <img src="@img" alt="@item.ProductName" class="product-image">
                                </a>
                                <div class="product-action-vertical">
                                    <a href="#"
                                       class="btn-product-icon btn-wishlist btn-expandable js-wishlist-remove is-in-wishlist"
                                       data-pid="@item.ProductID"
                                       title="@Html.Translate("#Remove from Wishlist#")">
                                        <span>@Html.Translate("#Remove from Wishlist#")</span>
                                    </a>
                                </div>
                                <div class="product-action">
                                    @{ ViewData["ProductUrl"] = productUrl; }
                                    @await Html.PartialAsync("_ProductListAddToCartPartial", new ProductList
                                    {
                                        ProductID = item.ProductID,
                                        ProductName = item.ProductName,
                                        Url = item.Url,
                                        Price = item.Price,
                                        CurrencyName = item.CurrencyName
                                    })
                                </div>
                            </figure>
                            <div class="product-body">
                                @{ ViewData["ProductUrl"] = productUrl; }
                                @await Html.PartialAsync("_ProductListTitlePartial", new ProductList
                                {
                                    ProductID = item.ProductID,
                                    ProductName = item.ProductName,
                                    Url = item.Url
                                })
                                @if (item.Price.HasValue)
                                {
                                    <div class="product-price">@CurrencyDisplayHelper.FormatAmount(item.Price, item.CurrencyName)</div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
